DENSITY_RULES = [
    (["brick",       "\u0637\u0648\u0628", "masonry",  "clay"],         18.0),
    (["rc ",         "reinforced", "concrete", "\u062e\u0631\u0633\u0627\u0646\u0629", "cast"], 24.0),
    (["block",       "cmu",     "hollow",   "\u0627\u0633\u0645\u0646\u062a"],         14.0),
    (["partition",   "gypsum",  "light",    "\u062d\u0648\u0627\u062c\u0632", "drywall"],  8.0),
    (["stone",       "\u062d\u062c\u0631",   "limestone"],                           22.0),
    (["aac",         "aircrete", "ytong"],                                   7.0),
]
DEFAULT_DENSITY = 18.0   # kN/m3 masonry fallback


# ===========================================================================
# HELPER FUNCTIONS
# ===========================================================================

def get_wall_height_mm(wall):
    p = wall.get_Parameter(BuiltInParameter.WALL_USER_HEIGHT_PARAM)
    if p is not None and p.AsDouble() > 0.001:
        return UnitUtils.ConvertFromInternalUnits(p.AsDouble(), UnitTypeId.Millimeters)
    bb = wall.get_BoundingBox(None)
    if bb is not None:
        return (bb.Max.Z - bb.Min.Z) * 304.8   # feet -> mm
    return 3000.0


def get_wall_thickness_mm(wall):
    wt = doc.GetElement(wall.GetTypeId())
    try:
        cs = wt.GetCompoundStructure()
        if cs is not None:
            return UnitUtils.ConvertFromInternalUnits(cs.GetWidth(), UnitTypeId.Millimeters)
    except Exception:
        pass
    p = wt.get_Parameter(BuiltInParameter.WALL_ATTR_WIDTH_PARAM)
    if p is not None and p.AsDouble() > 0.0:
        return UnitUtils.ConvertFromInternalUnits(p.AsDouble(), UnitTypeId.Millimeters)
    return 200.0


def guess_density(type_name):
    name_lower = type_name.lower()
    for keywords, density in DENSITY_RULES:
        if any(k in name_lower for k in keywords):
            return density
    return DEFAULT_DENSITY


def calc_suggested_load(thickness_mm, height_mm, density_knm3):
    return round(density_knm3 * (thickness_mm / 1000.0) * (height_mm / 1000.0), 2)


def get_wall_angle(curve):
    """
    Return the wall direction angle in radians (measured from X-axis).
    Used to rotate the TextNote so it aligns with the wall in plan view.

    The angle is clamped to (-90°, +90°] so text is never upside-down.
    Revit's KeepRotatedTextReadable flag handles this automatically, but
    the manual clamp is a safe backup for older Revit versions.
    """
    start    = curve.GetEndPoint(0)
    end      = curve.GetEndPoint(1)
    wall_dir = (end - start)
    if wall_dir.GetLength() < 1e-9:
        return 0.0
    wall_dir = wall_dir.Normalize()
    angle    = math.atan2(wall_dir.Y, wall_dir.X)
    # Keep text readable — never rotate past ±90°
    if angle >  math.pi / 2.0:
        angle -= math.pi
    elif angle < -math.pi / 2.0:
        angle += math.pi
    return angle


def get_mid_point(curve):
    """Return the XY midpoint of the wall location curve."""
    return curve.Evaluate(0.5, True)


